---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { content, locales, type Locale } from "../../i18n/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = content[lang];
const page = copy.pages.contact;
---

<BaseLayout lang={lang} title={`${lang === "en" ? "Contact" : "Contacto"} | ${copy.brand}`} description={page.intro} pathname={`/${lang}/contact/`}>
  <section class="page-hero contact-hero">
    <div class="page-hero-inner">
      <p class="eyebrow"><span class="signal-mark" aria-hidden="true"></span>{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p class="page-hero-intro">{page.intro}</p>
    </div>
  </section>
  <section class="contact-section">
    <div class="contact-form-column">
      <h2>{page.formTitle}</h2>
      <ContactForm lang={lang} copy={copy} services={copy.serviceItems} />
    </div>
    <aside class="contact-sidebar">
      <div>
        <p class="eyebrow">{page.emailLabel}</p>
        <p>{page.emailPrompt}</p>
        <a class="email-link" href="mailto:hello@vaqzeryn.com">hello@vaqzeryn.com<span aria-hidden="true">↗</span></a>
      </div>
      <div class="contact-note">
        <span class="note-mark" aria-hidden="true">i</span>
        <p>{page.privacy}</p>
      </div>
    </aside>
  </section>
  <section class="contact-close">
    <div><p class="eyebrow">{lang === "en" ? "A simple first step" : "Un primer paso sencillo"}</p><h2>{page.closeTitle}</h2><p>{page.closeBody}</p></div>
    <a class="text-link" href="mailto:hello@vaqzeryn.com">hello@vaqzeryn.com<span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
