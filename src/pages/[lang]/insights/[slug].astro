---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { content, locales, type Locale } from "../../../i18n/content";

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    content[lang].articles.map((article) => ({
      params: { lang, slug: article.slug },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const copy = content[lang];
const article = copy.articles.find((item) => item.slug === Astro.params.slug);

if (!article) throw new Error(`Unknown article: ${Astro.params.slug}`);

const pathname = `/${lang}/insights/${article.slug}/`;
---

<BaseLayout lang={lang} title={`${article.title} | ${copy.brand}`} description={article.summary} pathname={pathname}>
  <article class="article-detail">
    <header class="article-detail-header">
      <p class="eyebrow"><a href={`/${lang}/insights/`}>{lang === "en" ? "Insights" : "Ideas"}</a><span aria-hidden="true"> / </span>{article.category}</p>
      <h1>{article.title}</h1>
      <p class="article-summary">{article.summary}</p>
      <p class="article-byline">{article.author} <span aria-hidden="true">·</span> {article.readTime}</p>
      <p class="disclaimer">{copy.pages.insights.note}</p>
    </header>
    <div class="article-body">
      <p class="article-lede">{article.intro}</p>
      {article.points.map((point) => <section><h2>{point.title}</h2><p>{point.body}</p></section>)}
      <a class="text-link" href={`/${lang}/insights/`}>{lang === "en" ? "Back to insights" : "Volver a las ideas"}<span aria-hidden="true">↗</span></a>
    </div>
  </article>
</BaseLayout>
