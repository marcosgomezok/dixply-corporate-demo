---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { content, locales, type Locale } from "../../../i18n/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const copy = content[lang];
const page = copy.pages.insights;
---

<BaseLayout lang={lang} title={`${lang === "en" ? "Insights" : "Ideas"} | ${copy.brand}`} description={page.intro} pathname={`/${lang}/insights/`}>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow"><span class="signal-mark" aria-hidden="true"></span>{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p class="page-hero-intro">{page.intro}</p>
    </div>
  </section>
  <section class="section articles-section">
    <p class="disclaimer articles-disclaimer">{page.note}</p>
    <div class="article-list">
      {copy.articles.map((article) => (
        <article class="article-card">
          <div class="article-card-main">
            <p class="card-kicker">{article.category} <span>·</span> {article.readTime}</p>
            <h2><a href={`/${lang}/insights/${article.slug}/`}>{article.title}</a></h2>
            <p>{article.summary}</p>
            <a class="text-link" href={`/${lang}/insights/${article.slug}/`}>{lang === "en" ? "Read article" : "Leer artículo"}<span aria-hidden="true">↗</span></a>
          </div>
          <span class="article-arrow" aria-hidden="true">↗</span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
