---
import type { Locale, SiteContent } from "../i18n/content";

interface Props {
  lang: Locale;
  copy: SiteContent;
  pathname: string;
}

const { lang, copy, pathname } = Astro.props;
const currentPath = pathname.replace(/^\/(en|es)/, "") || "/";
---

<a class="skip-link" href="#main">{copy.skip}</a>
<header class:list={["site-header", { "site-header-home": currentPath === "/" }]}>
  <div class="header-inner">
    <a class="wordmark" href={`/${lang}/`} aria-label={`${copy.brand} — ${copy.tagline}`}>
      <span class="brand-symbol" aria-hidden="true">V<span>.</span></span>
      <span class="brand-name">{copy.brand}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-close-label={copy.closeMenu}>
      <span class="menu-toggle-text" data-open-label={copy.menu}>{copy.menu}</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
    <nav id="primary-navigation" class="primary-navigation" aria-label={lang === "en" ? "Main navigation" : "Navegación principal"}>
      {
        copy.nav.map((item) => {
          const href = `/${lang}${item.href}`;
          const active = currentPath === item.href || currentPath.startsWith(item.href);
          return <a class:list={["nav-link", { "is-active": active }]} href={href} aria-current={active ? "page" : undefined}>{item.label}</a>;
        })
      }
      <div class="nav-tools">
        <div class="language-switch" aria-label={copy.language}>
          <a href={`/en${pathname.replace(/^\/(en|es)/, "")}`} lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href={`/es${pathname.replace(/^\/(en|es)/, "")}`} lang="es" aria-current={lang === "es" ? "true" : undefined}>ES</a>
        </div>
        <a class="button button-dark nav-cta" href={`/${lang}/contact/`}>{copy.contactLink}<span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </div>
</header>

<script is:inline src="/scripts/navigation.js"></script>
