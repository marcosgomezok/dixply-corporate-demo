---
import type { Locale, SiteContent } from "../i18n/content";

interface Props {
  lang: Locale;
  copy: SiteContent;
}

const { lang, copy } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a class="wordmark wordmark-light" href={`/${lang}/`}>
        <span class="brand-symbol" aria-hidden="true">V<span>.</span></span>
        <span class="brand-name">{copy.brand}</span>
      </a>
      <p>{copy.footerIntro}</p>
    </div>
    <div class="footer-column">
      <h2>{copy.footerExplore}</h2>
      {copy.nav.map((item) => <a href={`/${lang}${item.href}`}>{item.label}</a>)}
      <a href={`/${lang}/services/`}>{lang === "en" ? "All services" : "Todos los servicios"}</a>
    </div>
    <div class="footer-column footer-contact">
      <h2>{copy.footerContact}</h2>
      <p>{copy.footerNote}</p>
      <a href={`/${lang}/contact/`}>{copy.contactLink} <span aria-hidden="true">↗</span></a>
      <a href="mailto:hello@vaqzeryn.com">hello@vaqzeryn.com</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} {copy.brand}</span>
    <span>{copy.attribution}</span>
    <a href="#top" class="back-to-top">{lang === "en" ? "Back to top" : "Volver arriba"} ↑</a>
  </div>
</footer>
